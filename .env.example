# Used only at runtime; never commit your .env.
OPENAI_API_KEY=
CMAGENT_RUN_NAME=my_run

# Point directly at the upstream classifier's output directory.
CMAGENT_INPUT_DIR=./inputs
CMAGENT_OUTPUT_DIR=./outputs
CMAGENT_RESOURCES_DIR=./resources

# Set to the host user's id -u / id -g for writable bind mounts.
# CMAGENT_UID=1000
# CMAGENT_GID=1000

# Optional PostgreSQL destination; SQLite in /outputs is the Docker default.
# DATABASE_URL=postgresql+psycopg://user:password@database:5432/cell_marker
